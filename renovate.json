{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge GitHub Actions and mise-managed development tools",
      "matchManagers": [
        "github-actions",
        "mise"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
