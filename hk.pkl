amends "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.2.0/hk@2.2.0#/Builtins.pkl"

steps {
  // github actions
  ["actionlint"] = (Builtins.actionlint) {
    depends = List("newlines", "trailing_whitespace")
  }
  ["action_validator"] {
    profiles = List("qa")
    depends = List("yamlfmt")
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "action-validator {{files}}"
  }
  ["pinact"] = Builtins.pinact
  ["zizmor"] = Builtins.zizmor

  // markdown
  ["mdformat"] {
    types = List("markdown")
    exclude =
      List(
        ".claude/**/*.md",
        ".claude/**/*.markdown",
        "tests/resources/changelog/**/*.md",
        "tests/resources/changelog/**/*.markdown",
      )
    glob = List("**/*.md", "**/*.markdown")
    check = "mdformat --check {{files}}"
    fix = "mdformat {{files}}"
  }

  // mise
  ["mise"] = Builtins.mise

  // pkl
  ["pkl"] = Builtins.pkl
  ["pkl_format"] = Builtins.pkl_format

  // text
  ["newlines"] = (Builtins.newlines) {
    types = List("text")
    exclude = List("tests/resources/release/**", "tests/resources/changelog/**")
  }
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
    types = List("text")
    exclude = List("tests/resources/release/**", "tests/resources/changelog/**")
  }

  // toml
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = Builtins.taplo_format

  // zig
  ["zig_build"] {
    profiles = List("qa")
    glob = List("**/*.zig", "**/*.zon")
    check = "zig build --summary all"
  }
  ["zig_fmt"] {
    glob = List("**/*.zig", "**/*.zon")
    check = "zig fmt --check {{files}}"
    fix = "zig fmt {{files}}"
  }
  ["zig_test"] {
    profiles = List("qa")
    glob = List("**/*.zig")
    check = "zig build --summary all test"
  }
}
